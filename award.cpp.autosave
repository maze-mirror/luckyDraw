    //点开可以显示以往中奖名单
    
    
    QPushButton*btn1=new QPushButton(this);
    btn1->setText("开始");
    QPushButton*btn2=new QPushButton(this);
    btn2->setText("结束");
    
    //使用fisher-yates shuffle算法完成抽奖
